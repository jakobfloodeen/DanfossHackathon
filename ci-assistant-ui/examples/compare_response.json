  "insights": {
    "differences": [
      {
        "text": "Flow to each function is independent of its own load pressure and of the other functions' load pressures (load-independent flow control).",
        "sources": [
          1
        ]
      },
      {
        "text": "Rated flow per section depends on configuration: 100 l/min with pressure compensator and 125 l/min without, per the technical data table.",
        "sources": [
          3
        ]
      }
    ],
    "benefits": [
      {
        "text": "For AGCO's tractor: up to 12 work sections in one PVG 32 group, and other PVG families can be added through an interface module, so all machine functions can run from a single valve stack.",
        "sources": [
          1
        ]
      },
      {
        "text": "Load-sense relief valves on the A and B ports reduce energy loss at the target pressure.",
        "sources": [
          1
        ]
      },
      {
        "text": "CAN bus, PWM, ratiometric and ON/OFF electro-hydraulic control are all available, which suits connected machines.",
        "sources": [
          2
        ]
      }
    ],
    "tradeoffs": [
      {
        "text": "Work ports come as G1/2, 7/8-14 UNF or M22x1.5, so existing hose ends can usually be matched; check against the valve in use today.",
        "sources": [
          5
        ]
      },
      {
        "text": "Electro-hydraulic (PVE) actuation needs cleaner oil (18/16/13) than mechanical actuation (23/19/16).",
        "sources": [
          6
        ]
      }
    ]
  },
