# Copy to DanfossHackathon/.env and paste your key. Never commit .env!
ANTHROPIC_API_KEY=

# Which model does what (prices per million tokens input/output, Nov 2026):
#   claude-haiku-5-5   $0.10 / $0.50     claude-sonnet-5-5   $2 / $10
# Cheapest setup (default): Haiku writes the comparison; Sonnet only runs for the one retry when the
# code check finds a problem in Haiku's answer. For best text quality, set LLM_MODEL=claude-sonnet-5-5.
LLM_MODEL=claude-haiku-5-5          # the comparison text the salesperson reads (one call per comparison)
LLM_RETRY_MODEL=claude-sonnet-5-5   # only when code rejects the first answer
LLM_EFFORT=low                      # low / medium / high: thinking costs output tokens
EXTRACT_MODEL=claude-haiku-5-5      # PDF -> facts, one call per page (the biggest bill by far)
ASK_MODEL=claude-haiku-5-5          # free-text questions in the chat box ("Ask Dani")

# How much each comparison sends to the AI (smaller = cheaper; these defaults are tested)
PROMPT_MAX_CANDIDATES=3             # competitor products the AI compares (= columns on screen)
PROMPT_MAX_FACTS=40                 # most facts per product sent to the AI per comparison
PROMPT_MAX_UNSHARED=10              # of those, facts only that product has
